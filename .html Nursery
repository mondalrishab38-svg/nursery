<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>RANJIT NURSERY</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#fffaf8;
    color:#292124;
    transition:.3s;
}

/* ================= NAVBAR ================= */

.navbar{
    position:sticky;
    top:0;
    z-index:999;

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:14px 6%;

    background:#ffffffee;
    backdrop-filter:blur(15px);

    box-shadow:0 2px 15px #00000012;
}

.logo{
    font-size:21px;
    font-weight:800;
    color:#8b1740;
}

.logo span{
    font-size:25px;
}

.nav-right{
    display:flex;
    gap:8px;
}

.nav-btn{
    border:none;
    background:#f7e8ed;
    color:#8b1740;

    padding:10px 13px;
    border-radius:20px;

    cursor:pointer;
    font-weight:bold;
}

/* ================= HERO ================= */

.hero{
    min-height:88vh;

    display:flex;
    justify-content:center;
    align-items:center;

    text-align:center;

    padding:50px 20px;

    background:
    radial-gradient(circle at 50% 30%,#ffd9e3,transparent 35%),
    linear-gradient(135deg,#fff8f9,#fffdfb);
}

.hero-content{
    max-width:850px;
}

.hero-logo{
    font-size:65px;
    margin-bottom:10px;

    animation:float 3s ease-in-out infinite;
}

@keyframes float{
    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-10px);
    }
}

.hero h1{
    font-size:clamp(42px,8vw,82px);
    letter-spacing:2px;

    color:#8b1740;

    margin-bottom:15px;
}

.hero h2{
    font-size:clamp(18px,3vw,28px);
    font-weight:500;

    margin-bottom:20px;
}

.hero p{
    font-size:17px;
    line-height:1.7;

    opacity:.7;

    max-width:600px;
    margin:auto auto 28px;
}

.hero-info{
    display:flex;
    justify-content:center;
    gap:10px;
    flex-wrap:wrap;

    margin-bottom:30px;
}

.info-pill{
    padding:10px 16px;
    border-radius:30px;

    background:#ffffff;
    border:1px solid #efdce2;

    font-size:14px;
    font-weight:bold;
}

.explore-btn{
    display:inline-block;

    padding:16px 32px;

    border-radius:35px;

    background:linear-gradient(
        135deg,
        #8b1740,
        #d7446b
    );

    color:white;

    text-decoration:none;

    font-size:17px;
    font-weight:bold;

    box-shadow:0 12px 30px #8b174044;

    transition:.25s;
}

.explore-btn:hover{
    transform:translateY(-4px);
}

/* ================= CATALOGUE ================= */

#catalogue{
    padding:65px 6%;
}

.catalogue-title{
    text-align:center;
    margin-bottom:30px;
}

.catalogue-title h2{
    font-size:clamp(32px,5vw,50px);
    color:#8b1740;
}

.catalogue-title p{
    margin-top:8px;
    opacity:.65;
}

/* SEARCH */

.search-area{
    max-width:750px;
    margin:0 auto 35px;

    display:flex;
    gap:10px;
}

.search{
    flex:1;

    padding:15px 20px;

    border-radius:30px;

    border:1px solid #e7d5db;

    outline:none;

    font-size:16px;
}

/* GROUP */

.group{
    margin-bottom:55px;
}

.group-title{
    display:flex;
    align-items:center;
    gap:15px;

    margin-bottom:20px;
}

.group-title h3{
    font-size:25px;
    color:#8b1740;
}

.group-line{
    flex:1;
    height:2px;
    background:#ead7dd;
}

/* ROSE GRID */

.rose-grid{
    display:grid;

    grid-template-columns:
    repeat(auto-fill,minmax(210px,1fr));

    gap:20px;
}

/* CARD */

.rose-card{
    background:white;

    border-radius:20px;

    overflow:hidden;

    box-shadow:
    0 8px 25px #0000000b;

    transition:.25s;
}

.rose-card:hover{
    transform:translateY(-7px);

    box-shadow:
    0 15px 35px #00000016;
}

.rose-image{
    height:210px;

    position:relative;

    background:
    linear-gradient(
        135deg,
        #ffe3ea,
        #fff
    );

    display:flex;
    justify-content:center;
    align-items:center;

    overflow:hidden;
}

.rose-image img{
    width:100%;
    height:100%;

    object-fit:cover;

    transition:.4s;
}

.rose-card:hover img{
    transform:scale(1.06);
}

.no-image{
    font-size:65px;
}

.rose-details{
    padding:17px;
}

.rose-details h4{
    font-size:18px;
    margin-bottom:10px;
}

.price{
    font-size:19px;
    font-weight:bold;
    color:#9d2149;
}

.status{
    font-size:13px;
    color:#21833b;

    margin-top:6px;
}

.add-btn{
    width:100%;

    margin-top:13px;

    padding:11px;

    border:none;

    border-radius:25px;

    background:#8b1740;
    color:white;

    cursor:pointer;

    font-weight:bold;
}

.add-btn:disabled{
    background:#999;
    cursor:not-allowed;
}

/* ================= CART ================= */

.cart{
    position:fixed;

    top:0;
    right:-400px;

    width:min(380px,100%);
    height:100vh;

    z-index:2000;

    background:white;

    padding:25px;

    box-shadow:-10px 0 35px #00000025;

    transition:.35s;

    overflow-y:auto;
}

.cart.open{
    right:0;
}

.cart-header{
    display:flex;
    justify-content:space-between;

    align-items:center;

    margin-bottom:20px;
}

.close-btn{
    border:none;
    background:none;

    font-size:28px;

    cursor:pointer;
}

.cart-item{
    display:flex;
    justify-content:space-between;

    align-items:center;

    padding:13px 0;

    border-bottom:1px solid #eee;
}

.qty button{
    border:none;

    width:28px;
    height:28px;

    border-radius:50%;

    cursor:pointer;
}

.cart-total{
    font-size:21px;
    font-weight:bold;

    margin-top:25px;
}

.whatsapp{
    width:100%;

    margin-top:20px;

    padding:15px;

    border:none;

    border-radius:30px;

    background:#25d366;
    color:white;

    font-weight:bold;
    font-size:16px;

    cursor:pointer;
}

/* ================= FOOTER ================= */

footer{
    padding:45px 20px;

    text-align:center;

    background:#251419;

    color:white;
}

footer h2{
    color:#ff91ae;
    margin-bottom:10px;
}

footer p{
    opacity:.7;
    margin:6px;
}

/* ================= PETALS ================= */

.petal{
    position:fixed;

    top:-30px;

    z-index:1500;

    pointer-events:none;

    animation:fall linear forwards;
}

@keyframes fall{
    to{
        transform:
        translateY(110vh)
        rotate(600deg);
    }
}

/* ================= DARK ================= */

body.dark{
    background:#151011;
    color:#f7eeee;
}

body.dark .navbar{
    background:#21191bee;
}

body.dark .hero{
    background:
    radial-gradient(circle,#572132,transparent 40%),
    #151011;
}

body.dark .info-pill,
body.dark .rose-card,
body.dark .search,
body.dark .cart{
    background:#21191b;
    color:white;
}

body.dark .rose-image{
    background:#302023;
}

body.dark .group-line{
    background:#4b363b;
}

/* ================= MOBILE ================= */

@media(max-width:650px){

    .navbar{
        padding:12px 4%;
    }

    .logo{
        font-size:17px;
    }

    .hero{
        min-height:82vh;
    }

    .hero-logo{
        font-size:50px;
    }

    .hero h1{
        font-size:43px;
    }

    .hero p{
        font-size:15px;
    }

    #catalogue{
        padding:45px 4%;
    }

    .rose-grid{
        grid-template-columns:
        repeat(2,1fr);

        gap:12px;
    }

    .rose-image{
        height:170px;
    }

    .rose-details{
        padding:13px;
    }

    .rose-details h4{
        font-size:15px;
    }

    .price{
        font-size:16px;
    }

    .add-btn{
        font-size:13px;
    }

    .search-area{
        margin-bottom:25px;
    }
}

</style>
</head>


