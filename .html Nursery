/* ================= CART ================= */

let cart =
JSON.parse(
localStorage.getItem("ranjitCart") || "[]"
);


/* ================= CREATE IMAGE PATH =================

   IMPORTANT:

   Put your rose photos inside:

   images/

   Example:

   images/solare.jpg
   images/topaz.jpg
   images/white-avalanche.jpg

   The website automatically tries to load
   the matching image.

===================================================== */

function imageName(name){

    return "images/" +
    name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-|-$/g,"")
    + ".jpg";

}


/* ================= RENDER ================= */

function renderCatalogue(){

    const container =
    document.getElementById(
        "catalogueContainer"
    );

    const search =
    document
    .getElementById("search")
    .value
    .toLowerCase()
    .trim();

    container.innerHTML="";


    roseGroups.forEach(group=>{

        const filtered =
        group.roses.filter(rose =>
            rose[0]
            .toLowerCase()
            .includes(search)
        );


        if(
            search &&
            filtered.length===0
        ){
            return;
        }


        const section =
        document.createElement("div");

        section.className="group";


        section.innerHTML=`

            <div class="group-title">

                <h3>
                    ${group.name}
                </h3>

                <div class="group-line"></div>

            </div>

            <div class="rose-grid"></div>

        `;


        const grid =
        section.querySelector(
            ".rose-grid"
        );


        filtered.forEach(rose=>{

            const name=rose[0];
            const price=rose[1];
            const available=rose[2];


            const card =
            document.createElement("div");

            card.className="rose-card";


            const safeName =
            name
            .replace(/'/g,"\\'");


            card.innerHTML=`

                <div class="rose-image">

                    <img
                    src="${imageName(name)}"
                    alt="${name}"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='block';">

                    <div
                    class="no-image"
                    style="display:none">

                        🌹

                    </div>

                </div>


                <div class="rose-details">

                    <h4>
                        ${name}
                    </h4>

                    <div class="price">
                        ₹${price}
                    </div>

                    <div class="status">

                        ${available
                        ? "● Available"
                        : "● unAvailable"}

                    </div>


                    <button
                    class="add-btn"
                    ${!available?"disabled":""}
                    onclick="addToCart('${safeName}')">

                        ${available
                        ? "+ Select Rose"
                        : "Unavailable"}

                    </button>

                </div>

            `;


            grid.appendChild(card);

        });


        container.appendChild(section);

    });

}


/* ================= SEARCH ================= */

document
.getElementById("search")
.addEventListener(
    "input",
    renderCatalogue
);


/* ================= CART ADD ================= */

function addToCart(name){

    const item =
    cart.find(
        x=>x.name===name
    );


    if(item){

        item.qty++;

    }else{

        cart.push({
            name:name,
            qty:1
        });

    }


    saveCart();

    openCart();

}


/* ================= FIND ROSE ================= */

function findRose(name){

    for(
        const group of roseGroups
    ){

        const rose =
        group.roses.find(
            x=>x[0]===name
        );

        if(rose){
            return rose;
        }

    }

    return null;

}


/* ================= SAVE CART ================= */

function saveCart(){

    localStorage.setItem(
        "ranjitCart",
        JSON.stringify(cart)
    );

    renderCart();

}


/* ================= CART RENDER ================= */

function renderCart(){

    const box =
    document.getElementById(
        "cartItems"
    );

    box.innerHTML="";

    let total=0;
    let count=0;


    cart.forEach(item=>{

        const rose =
        findRose(item.name);

        if(!rose)return;


        total +=
        rose[1] * item.qty;

        count +=
        item.qty;


        const div =
        document.createElement("div");

        div.className="cart-item";


        div.innerHTML=`

            <div>

                <strong>
                    ${rose[0]}
                </strong>

                <br>

                <small>
                    ₹${rose[1]} × ${item.qty}
                </small>

            </div>


            <div class="qty">

                <button
                onclick="changeQty('${rose[0]}',-1)">
                    −
                </button>

                <span>
                    ${item.qty}
                </span>

                <button
                onclick="changeQty('${rose[0]}',1)">
                    +
                </button>

            </div>

        `;


        box.appendChild(div);

    });


    document
    .getElementById("cartTotal")
    .textContent =
    "Total: ₹" + total;


    document
    .getElementById("cartCount")
    .textContent =
    count;

}


/* =========
